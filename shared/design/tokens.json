{
  "$metadata": {
    "name": "OpenTivi Design System",
    "version": "2.0.0",
    "colorFormat": "hsl",
    "iconLibrary": "lucide (ISC license)",
    "grid": "4px base unit"
  },

  "color": {
    "$description": "All colors in HSL for perceptual consistency. Dark and light modes share the same hue/saturation family.",

    "light": {
      "background":         { "$value": "hsl(0, 0%, 100%)",       "$description": "Page canvas" },
      "foreground":         { "$value": "hsl(240, 10%, 4%)",      "$description": "Primary text" },

      "card":               { "$value": "hsl(0, 0%, 100%)",       "$description": "Card / container background" },
      "cardForeground":     { "$value": "hsl(240, 10%, 4%)",      "$description": "Card text" },

      "popover":            { "$value": "hsl(0, 0%, 100%)",       "$description": "Dropdown / tooltip bg" },
      "popoverForeground":  { "$value": "hsl(240, 10%, 4%)",      "$description": "Popover text" },

      "primary":            { "$value": "hsl(221, 83%, 53%)",     "$description": "Brand accent — buttons, links, active states" },
      "primaryForeground":  { "$value": "hsl(210, 40%, 98%)",     "$description": "Text on primary" },

      "secondary":          { "$value": "hsl(240, 5%, 96%)",      "$description": "Secondary button, badge, subtle bg" },
      "secondaryForeground":{ "$value": "hsl(240, 6%, 10%)",      "$description": "Text on secondary" },

      "muted":              { "$value": "hsl(240, 5%, 96%)",      "$description": "Disabled bg, skeleton" },
      "mutedForeground":    { "$value": "hsl(240, 5%, 43%)",      "$description": "Muted text, placeholder — darkened for 5.1:1 on muted bg" },

      "accent":             { "$value": "hsl(240, 5%, 93%)",      "$description": "Hover bg, accent surfaces — distinct from secondary" },
      "accentForeground":   { "$value": "hsl(240, 6%, 10%)",      "$description": "Text on accent" },

      "destructive":        { "$value": "hsl(0, 84%, 46%)",       "$description": "Error, delete — darkened for 5.3:1 on white" },
      "destructiveForeground":{ "$value": "hsl(0, 0%, 98%)",      "$description": "Text on destructive" },

      "success":            { "$value": "hsl(142, 64%, 31%)",     "$description": "Success states — darkened for 4.9:1 on white" },
      "successForeground":  { "$value": "hsl(0, 0%, 98%)",        "$description": "Text on success" },

      "warning":            { "$value": "hsl(38, 92%, 32%)",      "$description": "Warning states — darkened for 4.9:1 on white" },
      "warningForeground":  { "$value": "hsl(0, 0%, 98%)",        "$description": "Text on warning — white on dark amber" },

      "info":               { "$value": "hsl(210, 92%, 45%)",     "$description": "Informational states" },
      "infoForeground":     { "$value": "hsl(0, 0%, 98%)",        "$description": "Text on info" },

      "border":             { "$value": "hsl(240, 6%, 90%)",      "$description": "Default border" },
      "input":              { "$value": "hsl(240, 6%, 90%)",      "$description": "Input border" },
      "ring":               { "$value": "hsl(221, 83%, 53%)",     "$description": "Focus ring" },

      "favorite":           { "$value": "hsl(45, 93%, 37%)",      "$description": "Star / favorite — darkened gold for 3.2:1 on white" },
      "live":               { "$value": "hsl(0, 84%, 50%)",       "$description": "Live indicator — darkened for 4.6:1 on white" },

      "colorExtended": {
        "primaryHover":     { "$value": "hsl(221, 83%, 58%)",     "$description": "Brighter primary for hover" },
        "primaryLight":     { "$value": "hsl(221, 83%, 70%)",     "$description": "Lighter primary for subtle highlights" }
      }
    },

    "dark": {
      "background":         { "$value": "hsl(240, 10%, 4%)",      "$description": "Page canvas — near-black with blue warmth" },
      "foreground":         { "$value": "hsl(0, 0%, 95%)",        "$description": "Primary text" },

      "card":               { "$value": "hsl(240, 6%, 10%)",      "$description": "Card bg — subtle lift from canvas" },
      "cardForeground":     { "$value": "hsl(0, 0%, 95%)",        "$description": "Card text" },

      "popover":            { "$value": "hsl(240, 6%, 15%)",      "$description": "Dropdown / tooltip bg" },
      "popoverForeground":  { "$value": "hsl(0, 0%, 95%)",        "$description": "Popover text" },

      "primary":            { "$value": "hsl(217, 91%, 60%)",     "$description": "Brand accent — slightly brighter for dark bg" },
      "primaryForeground":  { "$value": "hsl(0, 0%, 100%)",       "$description": "Text on primary" },

      "secondary":          { "$value": "hsl(240, 4%, 16%)",      "$description": "Secondary button, subtle bg" },
      "secondaryForeground":{ "$value": "hsl(0, 0%, 95%)",        "$description": "Text on secondary" },

      "muted":              { "$value": "hsl(240, 4%, 16%)",      "$description": "Disabled bg, skeleton" },
      "mutedForeground":    { "$value": "hsl(240, 5%, 65%)",      "$description": "Muted text, placeholder" },

      "accent":             { "$value": "hsl(240, 4%, 20%)",      "$description": "Hover bg, accent surfaces — distinct from secondary/muted" },
      "accentForeground":   { "$value": "hsl(0, 0%, 95%)",        "$description": "Text on accent" },

      "destructive":        { "$value": "hsl(0, 70%, 64%)",       "$description": "Error text — brightened for 5.0:1 on dark surfaces" },
      "destructiveForeground":{ "$value": "hsl(0, 0%, 95%)",      "$description": "Text on destructive" },

      "success":            { "$value": "hsl(142, 71%, 45%)",     "$description": "Success states" },
      "successForeground":  { "$value": "hsl(150, 50%, 10%)",     "$description": "Text on success — dark text for 7:1 on green bg" },

      "warning":            { "$value": "hsl(38, 92%, 50%)",      "$description": "Warning states" },
      "warningForeground":  { "$value": "hsl(38, 92%, 14%)",      "$description": "Text on warning" },

      "info":               { "$value": "hsl(210, 92%, 55%)",     "$description": "Informational states" },
      "infoForeground":     { "$value": "hsl(0, 0%, 100%)",       "$description": "Text on info" },

      "border":             { "$value": "hsl(240, 4%, 16%)",      "$description": "Default border — subtle" },
      "input":              { "$value": "hsl(240, 4%, 16%)",      "$description": "Input border" },
      "ring":               { "$value": "hsl(217, 91%, 60%)",     "$description": "Focus ring" },

      "favorite":           { "$value": "hsl(45, 93%, 47%)",      "$description": "Star / favorite — warm yellow on dark bg" },
      "live":               { "$value": "hsl(0, 84%, 61%)",       "$description": "Live indicator — bumped for 4.6:1 on card bg" },

      "colorExtended": {
        "primaryHover":     { "$value": "hsl(217, 91%, 65%)",     "$description": "Brighter primary for hover" },
        "primaryLight":     { "$value": "hsl(217, 91%, 75%)",     "$description": "Lighter primary for subtle highlights" }
      }
    },

    "soft": {
      "$description": "Status soft backgrounds — semi-transparent tints for subtle status indication",
      "successSoft":      { "$value": "hsla(142, 71%, 45%, 0.18)" },
      "destructiveSoft":  { "$value": "hsla(0, 84%, 60%, 0.18)" },
      "warningSoft":      { "$value": "hsla(38, 92%, 50%, 0.18)" },
      "infoSoft":         { "$value": "hsla(210, 92%, 55%, 0.18)" }
    },

    "primaryAlpha": {
      "$description": "Primary color at various alpha levels for backgrounds and borders",
      "a13": { "$value": "hsla(217, 91%, 60%, 0.13)" },
      "a18": { "$value": "hsla(217, 91%, 60%, 0.18)" },
      "a20": { "$value": "hsla(217, 91%, 60%, 0.20)" },
      "a33": { "$value": "hsla(217, 91%, 60%, 0.33)" }
    }
  },

  "overlay": {
    "$description": "Semi-transparent surfaces for scrims, panels, and floating layers over content.",
    "scrim": { "color": "hsl(240, 10%, 4%)", "opacity": 0.72, "$description": "Full-screen dimming behind modals/dialogs" },
    "panel": { "color": "hsl(240, 6%, 10%)", "opacity": 0.88, "$description": "Floating side-panels, guide overlay on video" },
    "toast": { "color": "hsl(240, 10%, 4%)", "opacity": 0.80, "$description": "Transient notifications, error toasts" },

    "player": {
      "$description": "Player overlay — white tints used over video canvas",
      "gradientTop":    { "color": "hsl(240, 10%, 4%)", "opacity": 0.8,  "direction": "to bottom" },
      "gradientBottom": { "color": "hsl(240, 10%, 4%)", "opacity": 0.85, "direction": "to top" },
      "panel":          { "color": "hsl(240, 10%, 4%)", "opacity": 0.82 },
      "panelAlt":       { "color": "hsl(240, 10%, 4%)", "opacity": 0.78 },
      "btn":            { "color": "hsl(0, 0%, 100%)", "opacity": 0.15 },
      "track":          { "color": "hsl(0, 0%, 100%)", "opacity": 0.2 },
      "text":           { "$value": "hsl(0, 0%, 100%)" },
      "textDim":        { "color": "hsl(0, 0%, 100%)", "opacity": 0.7 },
      "textShadow":     { "$value": "0 2px 12px hsla(240, 10%, 4%, 0.8)" }
    }
  },

  "typography": {
    "$description": "Scale based on Major Second (1.125). Font sizes in px, line-heights as ratios.",

    "fontFamily": {
      "sans":  "Inter, SF Pro Display, -apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, sans-serif",
      "mono":  "JetBrains Mono, SF Mono, Consolas, monospace"
    },

    "scale": {
      "display":    { "size": 48, "lineHeight": 1.1,  "weight": 700, "tracking": -0.02,  "usage": "TV hero, splash" },
      "h1":         { "size": 32, "lineHeight": 1.2,  "weight": 700, "tracking": -0.02,  "usage": "Page title" },
      "h2":         { "size": 24, "lineHeight": 1.25, "weight": 600, "tracking": -0.01,  "usage": "Section title" },
      "h3":         { "size": 20, "lineHeight": 1.3,  "weight": 600, "tracking": -0.005, "usage": "Card group heading, dialog title" },
      "h4":         { "size": 16, "lineHeight": 1.4,  "weight": 600, "tracking": 0,      "usage": "Card title, list section header" },
      "body":       { "size": 14, "lineHeight": 1.5,  "weight": 400, "tracking": 0,      "usage": "Default text, paragraph" },
      "bodyLarge":  { "size": 16, "lineHeight": 1.5,  "weight": 400, "tracking": 0,      "usage": "EPG description, prominent body" },
      "small":      { "size": 13, "lineHeight": 1.45, "weight": 400, "tracking": 0,      "usage": "Secondary info, form hint" },
      "caption":    { "size": 12, "lineHeight": 1.35, "weight": 400, "tracking": 0.01,   "usage": "Timestamp, metadata" },
      "overline":   { "size": 11, "lineHeight": 1.35, "weight": 500, "tracking": 0.06,   "usage": "Section label, tab, chip — UPPERCASE" },
      "badge":      { "size": 10, "lineHeight": 1.2,  "weight": 600, "tracking": 0.02,   "usage": "Live indicator, count" }
    },

    "weight": {
      "regular":  400,
      "medium":   500,
      "semibold": 600,
      "bold":     700
    },

    "lineHeight": {
      "tight":    1.2,
      "normal":   1.5,
      "relaxed":  1.65
    }
  },

  "spacing": {
    "$description": "4px base unit. All spacing tokens are multiples of 4.",
    "0":  0,
    "px": 1,
    "0.5": 2,
    "1":  4,
    "1.5": 6,
    "2":  8,
    "3":  12,
    "4":  16,
    "5":  20,
    "6":  24,
    "8":  32,
    "10": 40,
    "12": 48,
    "16": 64,
    "20": 80
  },

  "radius": {
    "none":  0,
    "sm":    6,
    "md":    8,
    "lg":    12,
    "xl":    16,
    "2xl":   24,
    "full":  9999
  },

  "shadow": {
    "sm":   "0 1px 2px hsla(0, 0%, 0%, 0.05)",
    "md":   "0 4px 6px hsla(0, 0%, 0%, 0.07), 0 1px 3px hsla(0, 0%, 0%, 0.06)",
    "lg":   "0 10px 15px hsla(0, 0%, 0%, 0.1), 0 4px 6px hsla(0, 0%, 0%, 0.05)",
    "xl":   "0 20px 25px hsla(0, 0%, 0%, 0.15), 0 8px 10px hsla(0, 0%, 0%, 0.06)"
  },

  "motion": {
    "duration": {
      "fast":    100,
      "base":    150,
      "slow":    250,
      "slower":  400
    },
    "easing": {
      "default":    "cubic-bezier(0.16, 1, 0.3, 1)",
      "in":         "cubic-bezier(0.55, 0, 1, 0.45)",
      "out":        "cubic-bezier(0, 0.55, 0.45, 1)",
      "inOut":      "cubic-bezier(0.45, 0, 0.55, 1)"
    }
  },

  "layout": {
    "$description": "Composition rules — systematic spacing between elements",

    "page": {
      "padding": 24,
      "maxWidth": 1200,
      "$description": "Page-level horizontal padding"
    },

    "section": {
      "gap": 32,
      "$description": "Vertical gap between page-level sections"
    },

    "sectionHeader": {
      "marginBottom": 16,
      "$description": "Gap from h2/h3 to its content block (cards, list, etc.)"
    },

    "card": {
      "padding": 16,
      "gap": 12,
      "gridGap": 16,
      "$description": "Internal padding, gap between children, gap between cards in grid"
    },

    "list": {
      "itemGap": 0,
      "itemPadding": 12,
      "divider": true,
      "$description": "List items separated by 1px border, no gap"
    },

    "inline": {
      "gap": 8,
      "$description": "Gap between inline items: icon + text, tag + tag"
    },

    "stack": {
      "tight": 4,
      "default": 8,
      "loose": 16,
      "$description": "Vertical gap in stacked content: tight for label-to-value, default for form fields"
    }
  },

  "iconography": {
    "library": "lucide",
    "license": "ISC",
    "strokeWidth": 2,
    "sizes": {
      "xs": 14,
      "sm": 16,
      "md": 20,
      "lg": 24,
      "xl": 32
    },
    "packages": {
      "desktop": "lucide-react",
      "ios": "lucide-icons-swift (SPM)",
      "android": "lucide SVG assets or compose-icons"
    }
  },

  "platform": {
    "tv": {
      "safeArea":            { "x": 48, "y": 27 },
      "typographyScale":     1.15,
      "minFontSize":         14,
      "focusScale":          1.05,
      "focusBorderWidth":    3,
      "maxWhite":            "hsl(0, 0%, 94%)",
      "gridGap":             24,
      "sectionGap":          48,
      "cardRadius":          12,
      "$description":        "10-foot lean-back. No 1px lines. Focus ring mandatory."
    },
    "desktop": {
      "windowMinWidth":      960,
      "windowMinHeight":     640,
      "sidebarWidth":        220,
      "sidebarCollapsed":    64,
      "titleBarHeight":      38,
      "$description":        "Keyboard + mouse. Uses full token set as-is."
    },
    "mobile": {
      "minTouchTarget":      44,
      "tabBarHeight":        49,
      "navBarHeight":        44,
      "$description":        "Touch. iOS HIG minimum 44pt touch target."
    }
  }
}
